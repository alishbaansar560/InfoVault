@page
@model InfoVaultWeb.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-card">
    <h2>Create Account</h2>
    <h2>Get started</h2>
    <p class="auth-subtitle">Create an account to start organizing.</p>
    <form method="post">
        <div class="mb-4">
            <label>Username</label>
            <input asp-for="Username" class="form-control" />
        </div>
        <div class="mb-4">
            <label>Password</label>
            <div class="input-group">
                <input asp-for="Password" type="password" class="form-control" id="registerPassword" />
                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('registerPassword', this)" style="border-color: rgba(0,0,0,0.3); background: rgba(255,255,255,0.5); color: #000; border-top-right-radius: 10px; border-bottom-right-radius: 10px;">👁️</button>
            </div>
        </div>
        <button type="submit" class="btn btn-primary w-100 mt-2">Register</button>
        <div class="text-center mt-4">
            <a asp-page="/Login" class="btn-link">Sign in here</a>
        </div>

        @if (Model.Message != null)
        {
            <p style="margin-top:10px;">@Model.Message</p>
        }
    </form>
</div>

<script>
function togglePassword(inputId, btn) {
    var x = document.getElementById(inputId);
    if (x.type === "password") {
        x.type = "text";
        btn.innerText = "🙈";
    } else {
        x.type = "password";
        btn.innerText = "👁️";
    }
}
</script>
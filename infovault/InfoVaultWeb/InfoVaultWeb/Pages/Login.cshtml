@page
@model InfoVaultWeb.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-card">
    <h2>InfoVault Login</h2>
    <h2>Welcome back</h2>
    <p class="auth-subtitle">Log in to access your folders and notes.</p>
    <form method="post">
        <div class="mb-4">
            <label>Username</label>
            <input asp-for="Username" class="form-control" />
        </div>
        <div class="mb-4">
            <label>Password</label>
            <div class="input-group">
                <input asp-for="Password" type="password" class="form-control" id="loginPassword" />
                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('loginPassword', this)" style="border-color: rgba(0,0,0,0.3); background: rgba(255,255,255,0.5); color: #000; border-top-right-radius: 10px; border-bottom-right-radius: 10px;">👁️</button>
            </div>
        </div>
        <button type="submit" class="btn btn-primary w-100 mt-2">Login</button>
        <div class="text-center mt-4">
            <a asp-page="/Register" class="btn-link">Need an account?</a>
        </div>

        @if (Model.ErrorMessage != null)
        {
            <p style="color:red; margin-top:10px;">@Model.ErrorMessage</p>
        }
    </form>
</div>

<script>
function togglePassword(inputId, btn) {
    var x = document.getElementById(inputId);
    if (x.type === "password") {
        x.type = "text";
        btn.innerText = "🙈";
    } else {
        x.type = "password";
        btn.innerText = "👁️";
    }
}
</script>
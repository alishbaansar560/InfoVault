@page
@model InfoVaultWeb.Pages.NotFoundModel
@{
    ViewData["Title"] = "404 - Not Found";
}
<div class="auth-card text-center" style="margin-top:100px;">
    <h1>404</h1>
    <h2>Page Not Found</h2>
    <p class="auth-subtitle">The page you are looking for doesn't exist or has been moved.</p>
    <a asp-page="/Index" class="btn btn-primary mt-3">Return Home</a>
</div>

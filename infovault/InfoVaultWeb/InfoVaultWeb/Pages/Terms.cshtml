@page
@model InfoVaultWeb.Pages.TermsModel
@{
    ViewData["Title"] = "Terms of Service";
    ViewData["MetaDescription"] = "Read the InfoVault Terms of Service.";
}
<div class="auth-card" style="max-width: 800px; padding: 40px;">
    <h1>@ViewData["Title"]</h1>
    
    <p>Last updated: September 2026</p>

    <h4>1. Acceptance of Terms</h4>
    <p>By accessing or using InfoVault, you agree to be bound by these Terms of Service.</p>

    <h4>2. User Accounts</h4>
    <p>You are responsible for safeguarding the password that you use to access the service and for any activities or actions under your password.</p>

    <h4>3. Acceptable Use</h4>
    <p>You agree not to use the service for any unlawful purpose or in any way that could damage or impair the service.</p>
</div>

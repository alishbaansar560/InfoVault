@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["MetaDescription"] = "Read the InfoVault Privacy Policy to understand how we protect and manage your data.";
}
<div class="auth-card" style="max-width: 800px; padding: 40px;">
    <h1>@ViewData["Title"]</h1>
    
    <p>Last updated: September 2026</p>

    <h4>1. Information We Collect</h4>
    <p>We collect information you provide directly to us when you register for an account, create folders, or save notes. This includes your username and the content of your notes.</p>

    <h4>2. How We Use Your Information</h4>
    <p>We use the information we collect to operate, maintain, and provide the features of InfoVault. We do not sell your personal data to third parties.</p>

    <h4>3. Data Security</h4>
    <p>We implement appropriate technical and organizational security measures to protect your data against unauthorized access or destruction.</p>

    <h4>4. Contact Us</h4>
    <p>If you have any questions about this Privacy Policy, please contact us via our official support channels.</p>
</div>
